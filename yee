#include <iostream>
using namespace std;
class stack{
    public:
    int*arr;
    int size;
    int top;

    stack(int capacity){
        arr=new int[capacity];
        size=capacity;
        top=-1;
    }
    void push(int val){
        if(top==size-1){
            cout<<"stak is overflow"<<endl;
        }
        else{
            top++;
            arr[top]=val;
        }
        
    }
    void pop(){
        if(top==-1){
            cout<<"Stack is underflow";
        }
        arr[top]=-1;
        top--;
    }
    int setsize(){
        return top+1;
    }
    bool isempty(){
        if(top==-1){
            return true;
        }
        else{
            return false;
        }
    }

    int gettop(){
        if(top==-1){
            cout<<"The stack is empty";
            return -1;
        }
        else{
            return arr[top]; 
        }
    }
    void print(){
        for(int i=0;i<size;i++){
            cout<<arr[i]<<" ";
        }cout<<endl;
    }
};
using namespace std; 
int main() {
  stack s(4);
    s.push(10);
    s.push(11);
    s.push(13);
  // cout<< s.gettop();

    cout<<s.setsize()<<endl;
    cout<<s.isempty()<<endl;
    
}
